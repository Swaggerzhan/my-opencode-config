{
  "$schema": "https://opencode.ai/v2/cli.json",

  "plugins": [
    {
      "package": "opencode-subagent-magazine@latest",
      "options": {
        "enabled": true
      }
    }
  ],

  // TUI-only overrides tuned to feel closer to Claude Code.
  // In terminals, Command/Cmd usually cannot be captured reliably,
  // so Alt is used where Claude Code often uses Cmd/Option.
  "keybinds": {
    "leader": "ctrl+n",

    "app.exit": "<leader>q",
    "session.interrupt": "ctrl+c,escape",
    "prompt.clear": "<leader>l",

    "prompt.editor": "ctrl+g",
    "session.toggle.thinking": "ctrl+o",
    "model.list": "<leader>m",
    "command.palette.show": "ctrl+p",

    "input.submit": "return",
    "input.newline": "ctrl+return,shift+return,alt+return,ctrl+j",
    "input.delete.to.line.end": "ctrl+k",
    "input.delete.to.line.start": "none",
    "input.delete": "delete,shift+delete",
    "input.word.backward": "alt+b,alt+left,ctrl+left",
    "input.word.forward": "alt+f,alt+right,ctrl+right",

    "agent.cycle": "none",
    "agent.cycle.reverse": "shift+tab",
    "dialog.select.next": "down",
    "prompt.autocomplete.next": "down",
    "session.child.first": "<leader>j",
    "session.parent": "<leader>k",
    "session.child.next": "<leader>l",
    "session.child.previous": "<leader>h",

    "session.page.up": "none",
    "session.page.down": "none",
    "session.half.page.up": "ctrl+u",
    "session.half.page.down": "ctrl+d",
    "session.first": "home",
    "session.last": "end",
    "session.message.previous": "alt+k",
    "session.message.next": "alt+j",
    "session.messages_last_user": "alt+u"
  }
}
